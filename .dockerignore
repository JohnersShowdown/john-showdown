node_modules
logs
databases/*.db*
*.tsbuildinfo

# ESLint caches
.eslintcache
.eslintcache-no-types

# Test files
test
tools/set-import/sets

# Editor artifacts
.DS_Store
.idea
.vs
*~

# npm debug
npm-debug.log

# Private chat plugin files
server/chat-plugins/private
server/chat-plugins/private.js
server/chat-plugins/*-private.js
